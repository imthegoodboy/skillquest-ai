{
  "name": "skillquest-ai",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "SkillQuest AI for Anna",
  "scripts": {
    "build": "node scripts/build.mjs",
    "assets:logo": "node scripts/render-logo.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test && playwright test --config playwright.mobile.config.js",
    "test:e2e:live": "playwright test --config playwright.live.config.js",
    "check": "npm run build && npm test && anna-app validate --strict",
    "verify": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "axe-core": "^4.10.3",
    "esbuild": "^0.25.9"
  }
}
